# Supabase (project "btw")
NEXT_PUBLIC_SUPABASE_URL=https://wlkdhdkflbswjjdobsfs.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only – never expose to the client. Supabase "Secret key" (sb_secret_…) or the legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Temporary password for the first owner account (scripts/seed-owner.ts). Never commit a value.
SEED_OWNER_PASSWORD=
# Optional: transactional email (Resend). Without it emails are not sent, only logged as failed.
RESEND_API_KEY=
# Optional: Cloudflare Turnstile. Without BOTH keys the forms rely on honeypot + rate limit.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
